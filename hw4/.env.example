# Copy this file to hw4/.env and fill in your own key. Never commit the real .env.
# The backend (backend/agent.py) also reads a repo-root .env if present.

# Required: Portkey API key used to call OpenAI through the Portkey gateway
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides (defaults shown)
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=openai
# CAMPUS_MODEL=gpt-5.6-luna
